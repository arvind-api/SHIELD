# Copy to .env and fill in as needed. Used by docker-compose.yml.

# Backend
DATABASE_URL=sqlite:///./shield.db
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
# Set to true to force rule-based mock mode even if ANTHROPIC_API_KEY is set.
USE_MOCK_AI=false
# Cross-site deployments (frontend/backend on different domains) need
# COOKIE_SECURE=true and COOKIE_SAMESITE=none. Local dev can leave both unset.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
